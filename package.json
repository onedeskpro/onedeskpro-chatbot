{
	"name": "onedesk-pro-chatbot-sdk",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"dev": "turbo run dev",
		"type-check": "turbo run type-check",
		"test:e2e": "playwright test",
		"clean": "turbo run clean",
		"release:version": "pnpm -r --filter \"./packages/*\" exec npm version --no-git-tag-version",
		"release": "pnpm -r --filter \"./packages/*\" publish --access public"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"turbo": "^2.11.10",
		"typescript": "^6",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.6.0",
	"description": "Embeddable chatbot SDK for Onedesk Pro",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/onedeskpro/onedeskpro-chatbot-sdk.git"
	}
}