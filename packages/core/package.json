{
  "name": "@onedeskpro/chatbot-core",
  "version": "0.1.0",
  "description": "Framework-independent core for the Onedesk Pro Chatbot SDK",
  "license": "MIT",
  "author": "Typetech IT <support@onedeskpro.com>",
  "homepage": "https://github.com/onedeskpro/onedeskpro-chatbot-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onedeskpro/onedeskpro-chatbot-sdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/onedeskpro/onedeskpro-chatbot-sdk/issues"
  },
  "keywords": [
    "onedeskpro",
    "chatbot",
    "chat-widget",
    "customer-support",
    "sdk",
    "vanilla-js"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && cp dist/index.d.ts dist/index.d.cts",
    "test": "vitest run",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@onedeskpro/chatbot-types": "workspace:*",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "typescript": "^6",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4"
  }
}
